# Скопируйте этот файл в token.env и заполните значения.
# Обязательно: токен бота MAX.
MAX_BOT_TOKEN=PASTE_YOUR_MAX_BOT_TOKEN_HERE
# Код для регистрации учителей. Если оставить заглушку, учителем сможет стать любой пользователь.
TEACHER_CODE=PASTE_YOUR_TEACHER_CODE_HERE
# Часовой пояс для дат в сообщениях бота.
BOT_TIMEZONE=Asia/Omsk
